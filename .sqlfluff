# sqlfluff — BigQuery dialect, dbt-aware without needing a live dbt connection.
[sqlfluff]
dialect = bigquery
templater = jinja
max_line_length = 100
# Excluded to reduce friction on valid dbt/BigQuery patterns:
#   RF04 (keywords like `date` used as identifiers), AM04 (`select *` in staging),
#   ST06 (select-clause ordering). Tune per repo as needed.
exclude_rules = RF04, AM04, ST06

[sqlfluff:indentation]
tab_space_size = 2
indent_unit = space

# Lets sqlfluff understand {{ ref() }}, {{ source() }}, {{ config() }}, {{ var() }}
# and is_incremental() WITHOUT installing dbt or supplying credentials.
[sqlfluff:templater:jinja]
apply_dbt_builtins = true

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper
